{
  "agent": {
    "provider": "your_openai_compatible_provider",
    "base_url": "https://api.example.com/v1",
    "model": "your-tool-using-model",
    "api_key_env": "AGENT_API_KEY",
    "options": {"temperature": 0.7, "max_tokens": 4096}
  },
  "user": {
    "provider": "your_user_model_provider",
    "base_url": "https://api.example.com/v1",
    "model": "your-user-simulator-model",
    "api_key_env": "USER_API_KEY",
    "options": {"temperature": 0, "max_tokens": 2048}
  },
  "judge": {
    "provider": "your_judge_provider",
    "base_url": "https://api.example.com/v1",
    "model": "your-judge-model",
    "api_key_env": "JUDGE_API_KEY",
    "options": {"temperature": 0, "max_tokens": 12288, "response_format": {"type": "json_object"}}
  },
  "native": {"backend_root": "../vendor/tau2-bench", "data_dir": "../vendor/tau2-bench/data"}
}
